# Student OS Backend Environment Configuration
DATABASE_URL=sqlite:///./student_os.db
# To use local MySQL:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/student_os

JWT_SECRET=student-os-super-secret-jwt-key-2026-phase-1
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://localhost:3000
APP_ENV=development
COOKIE_SECURE=false

# Payments & UPI (Set your real UPI ID and payee name)
UPI_ID=yourname@bank
UPI_PAYEE_NAME=Your Name
ADMIN_EMAILS=yourname@example.com

# LLM Providers (Optional: gemini / openai)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=auto
