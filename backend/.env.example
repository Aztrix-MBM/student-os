# =====================================================================
# Student OS Backend Environment Configuration
# =====================================================================

# Database Connection URL:
# Development (SQLite):
DATABASE_URL=sqlite:///./student_os.db

# Production (PostgreSQL - Neon / Supabase / AWS RDS):
# DATABASE_URL=postgresql://user:password@ep-host.region.aws.neon.tech/student_os?sslmode=require

# Security & Authentication:
# In production, set JWT_SECRET to at least 32 random characters (e.g. openssl rand -hex 32)
JWT_SECRET=student-os-super-secret-jwt-key-2026-phase-1
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14

# Environment ('development' or 'production'):
# When set to production, server validates that JWT_SECRET is secure and COOKIE_SECURE is true.
APP_ENV=development
COOKIE_SECURE=false

# Allowed Frontend Origins (comma-separated):
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Proxy & Forwarded Headers:
# Set to '1' or comma-separated trusted proxy IPs if running behind reverse proxy (e.g. Render, Railway, Nginx)
TRUSTED_PROXIES=

# Payments & UPI (Configured by admin for manual UTR verification):
UPI_ID=
UPI_PAYEE_NAME=
ADMIN_EMAILS=admin@studentos.app

# Syllabus LLM Parsing (Optional: auto / gemini / openai):
LLM_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
